{
  "scripts": {
    "test": "cypress run",
    "test:open": "cypress open",
    "clean:cypress": "rm -rf cypress/videos/* cypress/screenshots/*",
    "test:chrome": "cypress run --browser chrome",
    "test:electron": "cypress run --browser electron",
    "test:all": "npm-run-all --continue-on-error test:chrome test:electron"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^22.1.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.5",
    "@cucumber/cucumber": "^11.3.0",
    "cypress": "^14.5.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.4.1",
    "mochawesome-report-generator": "^6.2.0",
    "npm-run-all": "^4.1.5"
  }
}
